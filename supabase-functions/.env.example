# Segredos das Edge Functions (google-oauth-callback e sync-google-calendar)
# Uso: supabase secrets set --env-file supabase-functions/.env
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY NÃO precisam estar aqui —
# o Supabase já injeta essas duas automaticamente dentro de toda Edge Function.

GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=https://SEU-PROJETO.supabase.co/functions/v1/google-oauth-callback
