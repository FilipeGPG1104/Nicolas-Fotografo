# =========================================================
# VARIÁVEIS DE AMBIENTE — Nicolas Fotografo
# Preencha com os valores reais e NUNCA suba este arquivo pro
# GitHub (ele já está listado no .gitignore).
# =========================================================

# ---- Front-end do site (usadas por api/config.js na Vercel) ----
# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI

# ---- Edge Functions do Supabase (Google Calendar) ----
# Essas NÃO vão pra Vercel — vão pro Supabase via
# `supabase secrets set --env-file supabase-functions/.env`
# (veja GUIA-2-GOOGLE-CALENDAR.md, Passo 4)
GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=https://SEU-PROJETO.supabase.co/functions/v1/google-oauth-callback

# ---- Somente para uso manual/local (NUNCA no front-end) ----
# Supabase → Project Settings → API → service_role (secret)
# Já é injetada automaticamente dentro das Edge Functions — só
# precisa disso se for rodar algum script administrativo local.
SUPABASE_SERVICE_ROLE_KEY=SUA-SERVICE-ROLE-KEY-AQUI
